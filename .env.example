# Catalyst Center MCP Server Configuration

# Database Configuration
DATABASE_URL=postgresql://mcp_user:changeme@postgres:5432/catalyst_center_mcp
DB_PASSWORD=changeme

# Security Configuration
EDIT_MODE_ENABLED=false
ENCRYPTION_KEY=generate-using-fernet-key-generation

# Catalyst Center token authentication
# Supported values: basic, aes256
CATALYST_CENTER_AUTH_MODE=basic
# Optional: base64-encoded username:password. If set, this is used for Basic auth token requests.
# CATALYST_CENTER_ENCODED_AUTH=
# Optional: 256-bit AES key for clusters configured to require CSCO-AES-256 auth.
# Accepts a 32-character raw string, 64-character hex string, or base64-encoded 32-byte value.
# CATALYST_CENTER_AES_KEY=
# Optional: pre-encrypted Base64 AES credential payload if you want to supply the ciphertext directly.
# CATALYST_CENTER_AES_ENCRYPTED_CREDENTIALS=

# Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8081
LOG_LEVEL=INFO

# Session Configuration
SESSION_SECRET_KEY=generate-random-secret-key
SESSION_TIMEOUT_MINUTES=30

# Optional: MCP API Token for remote access security
# MCP_API_TOKEN=your-secure-token-here

# =============================================================================
# SSL/TLS Configuration (HTTPS)
# =============================================================================

# Certificate generation settings
# CERT_DAYS       - Certificate validity period in days (default: 365)
# CERT_CN         - Certificate Common Name (default: catalyst-center)
# CERT_ORG        - Certificate Organization (default: Catalyst Center MCP)
# CERT_SERVER_IP  - Your server's IP address (added to certificate SANs)
#                   IMPORTANT: Set this to your server's IP for browser access
CERT_DAYS=365
CERT_CN=catalyst-center
CERT_ORG=Catalyst Center MCP
CERT_SERVER_IP=192.168.1.213

# =============================================================================
# Service URLs (HTTPS)
# =============================================================================

# PostgreSQL port (host-side mapping)
# Unique per stack: nexus=15432, catalyst=15433, fmc=15434
POSTGRES_PORT=15433

# Web API (FastAPI/MCP) HTTPS endpoint
# Unique per stack: nexus=8444, catalyst=8445, fmc=8446
# External access: https://YOUR_SERVER_IP:8445
WEB_API_PORT=8445

# Internal HTTP port (container-to-container, not exposed externally)
# Unique per stack: nexus=7100, catalyst=7101, fmc=7102
INTERNAL_HTTP_PORT=7101

# Web UI (Next.js) HTTPS endpoint
# Unique per stack: nexus=7443, catalyst=7444, fmc=7445
# External access: https://YOUR_SERVER_IP:7444
WEB_UI_PORT=7444

# Backend API URL (internal Docker network communication)
BACKEND_API_URL=https://catc_mcp_web_api:8445

# =============================================================================
# Notes
# =============================================================================
#
# Catalyst Center cluster credentials are managed via the Web UI.
# Configure clusters at https://YOUR_SERVER_IP:7444/clusters after starting.
#
# MCP SSE endpoint for Claude Desktop:
#   https://YOUR_SERVER_IP:8445/mcp/sse
#
# Self-signed certificates will generate browser warnings on first access.
# Accept the certificate to continue.
#
# To regenerate certificates:
#   1. docker compose down
#   2. docker volume rm catalyst-center-mcp-certs
#   3. docker compose up --build
